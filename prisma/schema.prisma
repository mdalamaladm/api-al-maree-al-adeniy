// This is your Prisma schema media,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  username String @id
  password String
  salt String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String 
  updatedBy String
}

model Media {
  alias String @id
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String
  files File[]
}

model Type {
  alias String @id
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String
  files File[]
}

model Content {
  id Int @id @default(autoincrement())
  name String
  isLecture Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String
  files File[]
}

model File {
  id Int @id @default(autoincrement())
  key String
  name String
  media Media @relation(fields: [mediaId], references: [alias], onDelete: SetDefault)
  type Type @relation(fields: [typeId], references: [alias], onDelete: SetDefault)
  content Content @relation(fields: [contentId], references: [id], onDelete: SetDefault)
  mediaId String @default("none")
  typeId String @default("none")
  contentId Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String
}
